# Copy this file to local_ai_server/vlm.env, then fill your GLM key.

# Zhipu GLM example. Keep the key in this local env file only; never paste it
# into the web page. These variables are used by the GLM buttons in Step1/Step2.
export PINDOU_GLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
export PINDOU_GLM_MODEL="glm-4v-flash"
export PINDOU_GLM_API_KEY="your-zhipu-api-key"
